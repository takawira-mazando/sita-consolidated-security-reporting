# SITA Platform - Unified Ingestion Environment Variables
# Copy to .env and fill in values for your environment

# =============================================================================
# DATABASE & INFRASTRUCTURE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://sita:password@localhost:5432/sita
REDIS_URL=redis://:password@localhost:6379/0

# =============================================================================
# PRODUCTION CREDENTIALS (used when running WITHOUT --demo flag)
# =============================================================================

# AppScan Cloud
APPSCAN_KEY_ID=your-prod-key-id
APPSCAN_KEY_SECRET=your-prod-key-secret
APPSCAN_ACCOUNT_ID=your-prod-account-uuid
# APPSCAN_APPLICATION_ID=your-prod-app-uuid  # optional
APPSCAN_BASE_URL=https://cloud.appscan.com
APPSCAN_PAGE_SIZE=200
APPSCAN_SCOPE=application

# Imperva DAM
IMPERVA_DAM_BASE_URL=https://your-prod.imperva.com
IMPERVA_DAM_API_KEY=your-prod-api-key

# Imperva WAF
IMPERVA_WAF_BASE_URL=https://your-prod.imperva.com
IMPERVA_WAF_API_KEY=your-prod-api-key

# APISec
APISEC_BASE_URL=https://api.prod.apisec.ai
APISEC_API_KEY=your-prod-api-key

# Compliance
COMPLIANCE_SOURCE_TYPE=csv
COMPLIANCE_CSV_PATH=/app/data/compliance.csv

# =============================================================================
# DEMO CREDENTIALS (used when running WITH --demo flag)
# These are TEST accounts provided by OEMs for demonstration purposes
# =============================================================================

# AppScan Cloud - Test Account
DEMO_APPSCAN_KEY_ID=your-demo-key-id
DEMO_APPSCAN_KEY_SECRET=your-demo-key-secret
DEMO_APPSCAN_ACCOUNT_ID=your-demo-account-uuid
# DEMO_APPSCAN_APPLICATION_ID=your-demo-app-uuid  # optional
DEMO_APPSCAN_BASE_URL=https://cloud.appscan.com
DEMO_APPSCAN_PAGE_SIZE=200
DEMO_APPSCAN_SCOPE=application

# Imperva DAM - Test Account
DEMO_IMPERVA_DAM_BASE_URL=https://your-demo.imperva.com
DEMO_IMPERVA_DAM_API_KEY=your-demo-api-key

# Imperva WAF - Test Account
DEMO_IMPERVA_WAF_BASE_URL=https://your-demo.imperva.com
DEMO_IMPERVA_WAF_API_KEY=your-demo-api-key

# APISec - Test Account
DEMO_APISEC_BASE_URL=https://api.demo.apisec.ai
DEMO_APISEC_API_KEY=your-demo-api-key

# Compliance - Demo Data
DEMO_COMPLIANCE_SOURCE_TYPE=csv
DEMO_COMPLIANCE_CSV_PATH=/app/data/demo_compliance.csv

# =============================================================================
# AUTH & SESSION
# =============================================================================
JWT_SECRET=your-strong-secret-here
JWT_TTL_SECONDS=43200
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin123
SEED_DEMO_USERS_ENABLED=true

# Notification channels (optional)
TEAMS_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =============================================================================
# AIMI - provider-hosted inference for the gated value propositions
# =============================================================================
# OFF BY DEFAULT. Leave this false and the platform makes no outbound AIMI call
# at all: every AI route serves its deterministic result, which is authoritative.
# Setting AIMI_ENABLED=true without AIMI_API_KEY is a startup failure, so a
# half-configured deployment cannot silently serve stale-looking AI output.
#
# What is permitted outbound: ATT&CK technique IDs, CVE IDs, and the threat-report
# text an analyst pasted in. Estate rows, identity rows and audit rows have no
# egress path by design (NFR-AI-11) and a payload carrying one is refused.
# Destination is registered in app/monitoring/egress.py under "aimi".
#
# Covers AVP-3 (campaign attribution) and AVP-8 (risk-delta causal attribution).
# AVP-2, AVP-5 and AVP-11 are deliberately not wired; the reasons are recorded in
# app/processing/intel/capability.py.
AIMI_ENABLED=false
AIMI_BASE_URL=https://aimiafrica.cloud
AIMI_API_KEY=
AIMI_TIMEOUT_SECONDS=10
AIMI_CIRCUIT_THRESHOLD=3
AIMI_CIRCUIT_COOLDOWN_SECONDS=60
AIMI_MAX_OUTBOUND_CHARS=8000